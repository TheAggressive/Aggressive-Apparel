# EditorConfig — what editors do while you type. It matches the formatters
# (wp-prettier with @wordpress/prettier-config for JS/TS/CSS/JSON, WPCS for
# PHP), so hand-written code is already in standard shape before format-on-save.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML forbids tabs; Prettier writes it with two spaces.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Docs are not run through Prettier and use space-indented lists.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
