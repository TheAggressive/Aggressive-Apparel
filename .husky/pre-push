export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
# Heavy gate, kept off the commit path so commits stay fast. Mirrors the
# CI gate: i18n (POT drift + PO validity), full test suite (JS + PHP), all
# linters, typecheck, PHPStan. i18n runs first — it needs no wp-env and is
# the cheapest check, so POT drift fails in seconds rather than after the
# PHP suite. Requires wp-env running for the PHP tests (pnpm env:start).
pnpm run qa

# End-to-end last: it is the slowest stage (~6 min) and the most environment
# dependent, so everything cheaper has already failed fast by this point.
# e2e was previously outside every gate, which is how specs asserting designs
# that were never implemented reached master red. Requires wp-env running and
# the browser installed (pnpm test:e2e:install).
#
# `pretest:e2e` rebuilds first — Playwright drives the compiled theme, so
# without it this would validate a stale build/ rather than what is being
# pushed. CI enforces the same suite (release.yml, the Tests job) because a
# local hook can be skipped with --no-verify.
pnpm run test:e2e
