# Theme header; its Version line is rewritten by bin/release/sync-version.sh.
/style.css

# Build outputs
build/
node_modules/

# WordPress core files
wp-*.php
wp-admin/
wp-includes/

# Vendor files
vendor/

# Local tooling state, not project source
.claude/
.cursor/
.vscode/

# Generated tooling artifacts. The format scripts also pass `--ignore-path
# .gitignore`, so root-level ignores are covered structurally rather than by
# duplicating them here. Prettier does NOT read nested .gitignore files, so
# languages/ (whose .gitignore hides the generated .mo and Jed .json that
# `pnpm i18n:compile` writes) must still be listed explicitly.
languages/
tests/e2e/.auth/
test-results/
playwright-report/
.lighthouseci/

# Playwright-written snapshots (updated with --update-snapshots).
tests/e2e/*-snapshots/

# Generated files
*.min.css
*.min.js

# Tool-owned lockfile. It is tracked, but pnpm rewrites it on every install,
# so letting Prettier reformat it just means the two fight each other.
pnpm-lock.yaml

# WordPress FSE templates and patterns — Prettier reformats multi-line divs
# and converts self-closing block comments, both of which break the block parser
templates/
patterns/
parts/
