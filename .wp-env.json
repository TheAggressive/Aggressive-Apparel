{
  "core": "https://wordpress.org/wordpress-7.0.2.zip",
  "phpVersion": "8.2",
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_AUTO_UPDATE_CORE": false
  },
  "port": 9910,
  "phpmyadminPort": 9912,
  "env": {
    "development": {
      "config": {
        "WP_MEMORY_LIMIT": "256M",
        "WP_MAX_MEMORY_LIMIT": "512M"
      },
      "mappings": {
        "wp-content/themes/aggressive-apparel": ".",
        "wp-content/mu-plugins": "./bin/wp-env/mu-plugins"
      }
    },
    "tests": {
      "port": 9920,
      "phpmyadminPort": 9922,
      "mappings": {
        "wp-content/themes/aggressive-apparel": "."
      }
    }
  }
}
