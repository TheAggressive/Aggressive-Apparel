{
  "core": "https://wordpress.org/wordpress-7.0.2.zip",
  "phpVersion": "8.2",
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_AUTO_UPDATE_CORE": false
  },
  "port": 9930,
  "testsPort": 9931,
  "env": {
    "development": {
      "plugins": [
        "https://downloads.wordpress.org/plugin/woocommerce.10.9.4.zip"
      ],
      "mappings": {
        "wp-content/themes/aggressive-apparel": "../..",
        "wp-content/mu-plugins": "../wp-env/mu-plugins"
      }
    },
    "tests": {
      "plugins": [
        "https://downloads.wordpress.org/plugin/woocommerce.10.9.4.zip"
      ],
      "mappings": {
        "wp-content/themes/aggressive-apparel": "../.."
      }
    }
  }
}
