#!/usr/bin/env bash

# WP-CLI entry point for the CI lanes: on host PHP in the i18n lane, inside the
# parity container in the PHP and package lanes. The PHAR is downloaded and
# checksum-verified by bin/ci/install-wp-cli.sh before this wrapper runs.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

exec php "${REPO_ROOT}/.cache/ci/wp" --allow-root "$@"
