{
  "name": "aggressive-apparel",
  "version": "0.0.0-development",
  "private": true,
  "description": "Official WooCommerce Block Theme for Aggressive Apparel",
  "author": "The Aggressive Network, LLC",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "theme",
    "woocommerce",
    "block-theme",
    "fse"
  ],
  "homepage": "https://github.com/TheAggressive/Aggressive-Apparel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAggressive/Aggressive-Apparel.git"
  },
  "bugs": {
    "url": "https://github.com/TheAggressive/Aggressive-Apparel/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "type": "module",
  "main": "index.js",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "@semantic-release/github": "^12.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/wordpress__block-editor": "^15.0.6",
    "@types/wordpress__edit-post": "^8.4.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@wordpress/annotations": "^3.52.0",
    "@wordpress/api-fetch": "^7.52.0",
    "@wordpress/block-editor": "^16.1.0",
    "@wordpress/block-library": "^10.3.0",
    "@wordpress/blocks": "^15.25.0",
    "@wordpress/browserslist-config": "^6.52.0",
    "@wordpress/components": "^37.0.0",
    "@wordpress/compose": "^8.5.0",
    "@wordpress/core-data": "^7.52.0",
    "@wordpress/data": "^10.52.0",
    "@wordpress/data-controls": "^4.52.0",
    "@wordpress/dom-ready": "^4.52.0",
    "@wordpress/editor": "^14.52.0",
    "@wordpress/element": "^8.4.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/eslint-plugin": "^25.8.0",
    "@wordpress/hooks": "^4.52.0",
    "@wordpress/html-entities": "^4.52.0",
    "@wordpress/i18n": "^6.25.0",
    "@wordpress/icons": "^15.3.0",
    "@wordpress/interactivity": "^6.52.0",
    "@wordpress/keyboard-shortcuts": "^5.52.0",
    "@wordpress/keycodes": "^4.52.0",
    "@wordpress/notices": "^5.52.0",
    "@wordpress/plugins": "7.52.0",
    "@wordpress/scripts": "^33.0.0",
    "@wordpress/stylelint-config": "^24.1.0",
    "@wordpress/url": "^4.52.0",
    "concurrently": "^9.2.4",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "dompurify": "^3.4.13",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-lightningcss": "^1.1.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "webpack-remove-empty-scripts": "^1.0.4",
    "yaml": "2.9.0"
  },
  "scripts": {
    "// 🧱 BLOCK DEVELOPMENT": "_",
    "create-block": "npx @wordpress/create-block@latest --no-plugin --namespace aggressive-apparel",
    "create-block-dynamic": "npx @wordpress/create-block@latest --no-plugin --namespace aggressive-apparel --variant dynamic",
    "create-block-interactive": "npx @wordpress/create-block@latest --no-plugin --namespace aggressive-apparel --template @wordpress/create-block-interactive-template",
    "// 🏗️ BUILD SCRIPTS": "_",
    "build": "rm -rf build && concurrently 'pnpm build:blocks' 'pnpm build:interactivity' 'pnpm build:modules' 'pnpm build:assets' 'pnpm build:icons' && pnpm build:manifest",
    "build:manifest": "wp-scripts build-blocks-manifest --input=build --output=build/blocks-manifest.php",
    "build:blocks": "wp-scripts build --config webpack.config.mjs --source-path=./src/blocks --output-path=./build/blocks && pnpm sync:php:blocks",
    "build:interactivity": "wp-scripts build --config webpack.config.mjs --source-path=./src/blocks-interactivity --output-path=./build/blocks-interactivity --experimental-modules && pnpm sync:php:interactivity",
    "sync:php:blocks": "find src/blocks \\( -name 'render.php' -o -name 'block.json' -o -name 'legal-entity-presets.json' \\) | while read f; do dest=\"build/${f#src/}\"; mkdir -p \"$(dirname $dest)\"; cp \"$f\" \"$dest\"; done",
    "sync:php:interactivity": "find src/blocks-interactivity \\( -name 'render.php' -o -name 'block.json' -o -name 'motion-variants.json' \\) | while read f; do dest=\"build/${f#src/}\"; mkdir -p \"$(dirname $dest)\"; cp \"$f\" \"$dest\"; done",
    "build:modules": "wp-scripts build --config webpack.modules.config.mjs",
    "build:assets": "node bin/clean-asset-build.mjs && wp-scripts build --config webpack.assets.config.mjs",
    "build:icons": "node bin/build-icons.mjs",
    "// 👀 WATCH SCRIPTS": "_",
    "watch": "concurrently 'wp-scripts start' 'pnpm watch:icons'",
    "watch:icons": "node bin/build-icons.mjs --watch",
    "start": "wp-scripts start",
    "// 🎨 FORMAT SCRIPTS": "_",
    "format": "pnpm format:fix",
    "format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore \"./**/*.{js,jsx,json,ts,tsx,yml,yaml}\" && pnpm format:css:fix",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore \"./**/*.{js,jsx,json,ts,tsx,yml,yaml}\" && pnpm format:css:check",
    "format:css:fix": "stylelint 'src/**/*.css' --fix",
    "format:css:check": "stylelint 'src/**/*.css'",
    "// 🔍 LINT SCRIPTS": "_",
    "lint:all": "pnpm run format:check && pnpm run lint:files && pnpm run lint:shell && pnpm run lint:js && pnpm run typecheck && pnpm run lint:css && pnpm run lint:php",
    "lint:files": "bash bin/check-file-length.sh && bash bin/check-external-assets.sh",
    "lint:shell": "bash bin/check-shell.sh",
    "lint:fix": "pnpm run format:fix && pnpm run lint:js:fix && pnpm run lint:css:fix && pnpm run lint:php:fix",
    "lint:js": "eslint src bin --ext .js,.jsx,.ts,.tsx,.mjs --max-warnings 0",
    "lint:js:fix": "eslint src bin --ext .js,.jsx,.ts,.tsx,.mjs --fix",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json && tsc --project tsconfig.e2e.json",
    "lint:css": "stylelint 'src/styles/**/*.css' 'src/blocks/**/style.css' 'src/blocks/**/editor.css' 'src/blocks-interactivity/**/style.css' 'src/blocks-interactivity/**/editor.css' && bash bin/check-design-system-css.sh",
    "lint:css:fix": "stylelint 'src/styles/**/*.css' 'src/blocks/**/style.css' 'src/blocks/**/editor.css' 'src/blocks-interactivity/**/style.css' 'src/blocks-interactivity/**/editor.css' --fix",
    "lint:php": "composer lint:php",
    "lint:php:fix": "composer lint:php:fix",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "lint:commit": "commitlint --edit",
    "// 🧪 TESTING SCRIPTS": "_",
    "pretest": "pnpm run build:icons",
    "test": "pnpm run test:js && pnpm run test:tools && pnpm run test:php",
    "test:js": "wp-scripts test-unit-js --passWithNoTests",
    "test:tools": "node bin/lib/icon-build.test.mjs && node bin/ci/contracts.test.mjs && node --test bin/ci/release-summary.test.mjs bin/release/verify-package.test.mjs bin/check-design-system-css.test.mjs bin/check-external-assets.test.mjs bin/check-file-length.test.mjs bin/check-shell.test.mjs bin/i18n/validate-po.test.mjs bin/i18n/lint-placeholders.test.mjs bin/release/verify-assets.test.mjs bin/wp-env/check.test.mjs && bash bin/wp-env/test.sh",
    "test:js:watch": "wp-scripts test-unit-js --watch",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c './vendor/bin/phpunit --testdox'",
    "test:unit": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c './vendor/bin/phpunit --testsuite=unit --testdox'",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c './vendor/bin/phpunit --testsuite=integration --testdox'",
    "test:security": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c './vendor/bin/phpunit --testsuite=security --testdox'",
    "test:accessibility": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c './vendor/bin/phpunit --testsuite=accessibility --testdox'",
    "test:performance": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c './vendor/bin/phpunit --testsuite=performance --testdox'",
    "test:coverage": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c './vendor/bin/phpunit --coverage-html=coverage --coverage-text --testdox'",
    "test:watch": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c './vendor/bin/phpunit --watch --testdox'",
    "test:any": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash bin/phpunit-any.sh",
    "// 📊 ANALYSIS SCRIPTS": "_",
    "analyse:php": "pnpm run phpstan",
    "analyse:php:baseline": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c 'XDEBUG_MODE=off ./vendor/bin/phpstan analyse --generate-baseline --memory-limit=2G'",
    "phpstan": "wp-env run tests-cli --env-cwd=wp-content/themes/aggressive-apparel bash -c 'XDEBUG_MODE=off ./vendor/bin/phpstan analyse --memory-limit=2G --verbose'",
    "perf:setup": "node bin/setup-chrome-deps.mjs",
    "perf:quick": "node bin/run-performance.mjs quick",
    "perf:report": "node bin/run-performance.mjs report",
    "perf:budget": "node bin/run-performance.mjs budget",
    "perf:auto:quick": "LHCI_ENSURE_SITE=1 node bin/run-performance.mjs quick",
    "perf:auto:report": "LHCI_ENSURE_SITE=1 node bin/run-performance.mjs report",
    "perf:auto:budget": "LHCI_ENSURE_SITE=1 node bin/run-performance.mjs budget",
    "perf:auto": "pnpm run build && LHCI_ENSURE_SITE=1 node bin/run-performance.mjs budget",
    "perf": "pnpm run build && pnpm run perf:budget",
    "preflight": "pnpm run qa && pnpm run perf:auto",
    "// 🌐 I18N SCRIPTS": "_",
    "i18n": "bash bin/i18n/all.sh",
    "i18n:pot": "bash bin/i18n/pot.sh",
    "i18n:sync": "bash bin/i18n/sync.sh",
    "i18n:compile": "bash bin/i18n/compile.sh",
    "i18n:status": "bash bin/i18n/status.sh",
    "i18n:check": "bash bin/i18n/check.sh",
    "i18n:locale": "bash bin/i18n/locale-new.sh",
    "i18n:translate": "bash bin/i18n/translate.sh",
    "// 🔧 WORDPRESS SCRIPTS": "_",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "wp-env": "wp-env",
    "// 🌍 ENVIRONMENT SCRIPTS": "_",
    "env:start": "bash bin/wp-env/start.sh",
    "env:stop": "wp-env stop",
    "env:check": "bash bin/wp-env/check.sh",
    "env:beta": "bash bin/wp-env/update-beta-channel.sh",
    "env:backup": "bash bin/wp-env/backup.sh",
    "env:backups": "bash bin/wp-env/restore.sh --list",
    "env:restore": "bash bin/wp-env/restore.sh",
    "env:clean:all": "bash bin/wp-env/lifecycle.sh clean",
    "env:destroy:all": "bash bin/wp-env/lifecycle.sh destroy",
    "env:reset": "bash bin/wp-env/lifecycle.sh reset",
    "env:logs": "wp-env logs",
    "cli": "wp-env run cli wp",
    "// 💻 DEVELOPMENT SCRIPTS": "_",
    "dev": "concurrently \"pnpm run watch\" \"pnpm run env:start\"",
    "setup": "pnpm install && pnpm run build && pnpm run env:start",
    "prepare": "husky",
    "precommit": "pnpm run format:fix && pnpm run lint:fix",
    "// 🔧 UTILITY SCRIPTS": "_",
    "composer:verify": "composer validate --strict && composer install --dry-run --no-interaction --no-scripts",
    "qa": "pnpm run ci:verify",
    "qa:fast": "bash bin/ci/node.sh qa:fast:pinned",
    "qa:fast:pinned": "bash bin/ci/verify-fast.sh",
    "qa:dev": "pnpm run i18n:check && pnpm run composer:verify && pnpm run test && pnpm run lint:all && pnpm run phpstan",
    "ci:doctor": "node bin/ci/doctor.mjs",
    "ci:frontend": "pnpm ci:doctor && pnpm lint:files && pnpm lint:shell && pnpm lint:js && pnpm typecheck && pnpm lint:css && pnpm format:check && pnpm test:js && pnpm test:tools && pnpm audit --prod --audit-level high",
    "ci:i18n": "pnpm ci:doctor && bash bin/ci/i18n.sh",
    "ci:build": "pnpm ci:doctor && pnpm build",
    "ci:env:reset": "bash bin/ci/reset-wp-env.sh",
    "ci:env:stop": "bash bin/ci/stop-wp-env.sh",
    "ci:php": "pnpm ci:doctor && bash bin/ci/php.sh",
    "ci:php:forward": "pnpm ci:doctor && bash bin/ci/php-forward.sh",
    "ci:package": "pnpm ci:doctor && bash bin/ci/package.sh",
    "ci:artifact": "pnpm ci:doctor && bash bin/ci/artifact.sh",
    "ci:browser:install": "playwright install chromium",
    "ci:e2e": "pnpm ci:doctor && bash bin/ci/e2e.sh",
    "ci:e2e:beta": "pnpm ci:doctor && CI=1 WP_BASE_URL=http://localhost:9910 playwright test",
    "ci:verify": "bash bin/ci/node.sh ci:verify:pinned",
    "ci:verify:pinned": "bash bin/ci/verify.sh",
    "test:e2e": "bash bin/ci/node.sh test:e2e:pinned",
    "test:e2e:pinned": "pnpm ci:build && pnpm ci:browser:install && pnpm ci:e2e",
    "test:e2e:dev": "pnpm build && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  }
}
