{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Section: Brand Accent",
	"slug": "section-brand-red",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/media-text",
		"core/cover"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|accent",
			"text": "var:preset|color|white"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|section-standard",
				"right": "var:preset|spacing|gutter",
				"bottom": "var:preset|spacing|section-standard",
				"left": "var:preset|spacing|gutter"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|white"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|white"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|black"
					}
				}
			},
			"button": {
				"border": {
					"color": "var:preset|color|black"
				},
				"color": {
					"background": "var:preset|color|black",
					"text": "var:preset|color|white"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|white",
						"text": "var:preset|color|accent"
					}
				}
			}
		}
	}
}
