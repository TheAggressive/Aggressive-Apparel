{
	"compilerOptions": {
		"target": "ES2021",
		"lib": [ "ES2021", "DOM", "DOM.Iterable" ],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"module": "ESNext",
		// "bundler" rather than the legacy "node" (node10), which TypeScript 6
		// reports as a hard error and TypeScript 7 removes. It is also the correct
		// model for this project: webpack resolves the imports, so package.json
		// "exports" maps and extensionless specifiers should be honoured.
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		// Theme script modules are bare specifiers that webpack externalizes and
		// the browser resolves through the import map; point the type checker at
		// their sources so their types can never drift from the code.
		"paths": {
			"@aggressive-apparel/helpers": [ "./src/interactivity/helpers.ts" ],
			"@aggressive-apparel/scroll-lock": [
				"./src/interactivity/scroll-lock.ts"
			],
			"@aggressive-apparel/use-overlay": [
				"./src/interactivity/use-overlay.ts"
			]
		},
		"types": [
			"jest",
			"node",
			"@types/react",
			"@types/react-dom",
			"@types/wordpress__block-editor",
			"@types/wordpress__edit-post"
		]
	},
	"include": [ "src/**/*", "types/**/*" ],
	"exclude": [ "node_modules", "vendor", "build" ]
}
